@using System.Web
@* One source chip: [n] file · page, plus the exact passage from the source. Clicking opens the document at that page with the passage highlighted. *@
@if (!string.IsNullOrWhiteSpace(viewerUrl))
{
    <a href="@viewerUrl" target="_blank" class="citation">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
        <div class="citation-content">
            <div class="citation-file">@(Number is null ? "" : $"[{Number}] ")@File@(Page is null ? "" : $" · page {Page}")</div>
            <div>@Quote</div>
        </div>
    </a>
}

@code {
    [Parameter]
    public int? Number { get; set; }

    [Parameter]
    public required string File { get; set; }

    [Parameter]
    public int? Page { get; set; }

    // Verbatim text from the indexed chunk (the semantic ranker's caption), never model-written
    [Parameter]
    public string? Quote { get; set; }

    private string? viewerUrl;

    protected override void OnParametersSet()
    {
        // The viewers search for a short, exact phrase; the first words of the passage are enough to land on it
        var phrase = Quote is null ? "" : string.Join(' ', Quote.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(8)).Trim('.', ',', '"', '\'');

        // Files come from the authorized /documents endpoint (see DocumentEndpoints.cs)
        viewerUrl = Path.GetExtension(File).ToLowerInvariant() switch
        {
            // Browser text fragment: scrolls to and highlights the phrase
            ".md" => $"lib/markdown_viewer/viewer.html?file=/documents/{HttpUtility.UrlEncode(File)}#:~:text={Uri.EscapeDataString(phrase)}",
            // PDF.js: open the cited page and highlight the phrase on it
            ".pdf" => $"lib/pdf_viewer/viewer.html?file=/documents/{HttpUtility.UrlEncode(File)}#page={Page ?? 1}&search={HttpUtility.UrlEncode(phrase)}&phrase=true",
            // Anything else (e.g. .docx): download the original
            _ => $"/documents/{HttpUtility.UrlEncode(File)}"
        };
    }
}
